            ${months.map((m,i)=>`
              <div class="chart-bar-wrap">
                <div style="font-size:9px;color:var(--text3);font-family:var(--font-mono)">₦${vals[i]}M</div>
                <div class="chart-bar-outer" style="height:${Math.round(vals[i]/maxV*100)}%">
                  <div class="chart-bar-inner" style="height:100%;background:${i===4?'var(--accent)':'rgba(79,255,176,0.35)'}"></div>
