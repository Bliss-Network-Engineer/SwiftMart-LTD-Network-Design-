  invCat = cat;
  renderInventory();
}
function renderInventory() {
  const stockF = document.getElementById('inv-stock-filter')?.value||'';
  let prods = PRODUCTS.filter(p=>{
    if (invCat && p.cat!==invCat) return false;
    if (stockF==='critical' && p.stock>5) return false;
    if (stockF==='low' && (p.stock<=5||p.stock>20)) return false;
    if (stockF==='ok' && p.stock<=20) return false;
    return true;
  });
  const stockColor = s => s===0?'var(--accent3)':s<=5?'var(--accent3)':s<=20?'var(--accent4)':'var(--accent)';
  const stockLabel = s => s===0?'Out of Stock':s<=5?'Critical':s<=20?'Low Stock':'In Stock';
  document.getElementById('inv-grid').innerHTML = prods.map(p=>`
    <div class="inv-card" onclick="openModal('edit-inv','${p.id}')">
      <div class="inv-thumb">${p.emoji}</div>
      <div class="inv-name" title="${p.name}">${p.name}</div>
      <div class="inv-sku">${p.sku}</div>
      <div class="inv-price">₦${p.price.toLocaleString()}</div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:6px">
        <div class="inv-stock" style="color:${stockColor(p.stock)}">${stockLabel(p.stock)}</div>
        <div class="inv-stock">${p.stock} units</div>
      </div>
      <div class="stock-bar">
        <div class="stock-fill" style="width:${Math.min(p.stock/100*100,100)}%;background:${stockColor(p.stock)}"></div>
      </div>
    </div>
  `).join('') || '<div class="empty"><div class="empty-icon">📦</div><div class="empty-text">No products match filters</div></div>';
}

