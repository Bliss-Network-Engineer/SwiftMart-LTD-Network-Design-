function closeModal() {
  document.getElementById('modal-overlay').classList.remove('open');
}

function createOrder() {
  const newId = 'ORD-'+(10892+ORDERS.length+1);
  ORDERS.unshift({id:newId,cust:'New Customer',items:1,total:Math.floor(Math.random()*20000+5000),status:'Pending',payment:'Pending',date:new Date().toISOString().slice(0,10),method:'Cash'});
  document.getElementById('order-badge').textContent = ORDERS.filter(o=>o.status==='Pending').length;
  closeModal();
  showToast(`${newId} created successfully`,'success');
  if(currentView==='orders') renderOrdersTable();
}

// ─── TOAST ───────────────────────────────────────────────────────────────────
function showToast(msg, type='info') {
  const cont = document.getElementById('toast-container');
  const toast = document.createElement('div');
  toast.className = `toast ${type}`;
  const icon = type==='success'?'✅':type==='error'?'❌':'ℹ️';
  toast.innerHTML = `<span>${icon}</span><span style="flex:1">${msg}</span>`;
  cont.appendChild(toast);
  setTimeout(()=>{ toast.style.opacity='0'; toast.style.transition='opacity 0.3s'; setTimeout(()=>toast.remove(),300); }, 3500);
}

// ─── GLOBAL SEARCH ───────────────────────────────────────────────────────────
function globalSearch(v) {
  if (!v) return;
  const prodMatch = PRODUCTS.filter(p=>p.name.toLowerCase().includes(v.toLowerCase()));
  const orderMatch = ORDERS.filter(o=>o.id.toLowerCase().includes(v.toLowerCase())||o.cust.toLowerCase().includes(v.toLowerCase()));
  if (prodMatch.length>0) {
    navigate('products');
    setTimeout(()=>{ document.getElementById('prod-search').value=v; renderProductsTable(); },100);
  } else if (orderMatch.length>0) {
    navigate('orders');
    setTimeout(()=>{ document.getElementById('order-search').value=v; renderOrdersTable(); },100);
  }
}

// ─── INIT ────────────────────────────────────────────────────────────────────
renderDashboard();
