// ─── ORDERS ─────────────────────────────────────────────────────────────────
function statusBadge(s) {
  const map = {Pending:'badge-yellow',Processing:'badge-blue',Shipped:'badge-purple',Delivered:'badge-green',Cancelled:'badge-red'};
  return map[s]||'badge-gray';
}
function payBadge(s) {
  return s==='Paid'?'badge-green':s==='Refunded'?'badge-red':'badge-yellow';
}

function renderOrdersTable() {
  const statusF = document.getElementById('order-status-filter').value;
  const payF = document.getElementById('order-pay-filter').value;
  const search = document.getElementById('order-search').value.toLowerCase();
  let orders = ORDERS.filter(o=>{
    if (statusF && o.status!==statusF) return false;
    if (payF && o.payment!==payF) return false;
    if (search && !o.id.toLowerCase().includes(search) && !o.cust.toLowerCase().includes(search)) return false;
    return true;
  });
  document.getElementById('order-count').textContent = `${orders.length} orders`;
  document.getElementById('orders-tbody').innerHTML = orders.map(o=>`
    <tr class="tr-clickable">
      <td><span class="order-id">${o.id}</span></td>
      <td>${o.cust}</td>
      <td>${o.items}</td>
      <td style="font-family:var(--font-mono);color:var(--accent)">₦${o.total.toLocaleString()}</td>
      <td><span class="badge ${statusBadge(o.status)}">${o.status}</span></td>
      <td><span class="badge ${payBadge(o.payment)}">${o.payment}</span></td>
      <td style="color:var(--text2);font-size:12px">${o.date}</td>
      <td>
        <div style="display:flex;gap:6px">
          <button class="btn btn-ghost btn-sm" onclick="viewOrder('${o.id}')">View</button>
          ${o.status==='Pending'?`<button class="btn btn-primary btn-sm" onclick="updateStatus('${o.id}','Processing')">Process</button>`:''}
        </div>
      </td>
    </tr>
  `).join('');
}

function viewOrder(id) {
  const o = ORDERS.find(x=>x.id===id);
  openModal('view-order', o);
}
function updateStatus(id, status) {
  ORDERS = ORDERS.map(o=>o.id===id?{...o,status}:o);
  renderOrdersTable();
  showToast(`${id} updated to ${status}`,'success');
}

