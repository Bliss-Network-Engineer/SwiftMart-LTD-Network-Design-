          ${[
            {l:'Total Revenue YTD',v:'₦20.7M',up:true,d:'+18.3%'},
            {l:'Gross Profit Margin',v:'28.4%',up:true,d:'+2.1pp'},
            {l:'Avg Order Value',v:'₦5,830',up:true,d:'+7.2%'},
